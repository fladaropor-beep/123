<mxfile host="app.diagrams.net" agent="ChatGPT" version="24.7.17"><diagram name="Варианты использования — Звезда"><mxGraphModel dx="1160" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1160" pageHeight="800" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Интернет-магазин электроники «Звезда» — диаграмма вариантов использования" style="text;html=1;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;strokeColor=none;fillColor=none;" parent="1" vertex="1"><mxGeometry x="240" y="15" width="700" height="40" as="geometry" /></mxCell><mxCell id="boundary" value="Система «Звезда»" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;strokeWidth=2;strokeColor=#666666;fillColor=none;verticalAlign=top;align=center;fontSize=16;fontStyle=1;spacingTop=10;" parent="1" vertex="1"><mxGeometry x="230" y="80" width="760" height="670" as="geometry" /></mxCell><mxCell id="a1" value="Оператор загрузки" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=12;" parent="1" vertex="1"><mxGeometry x="40" y="155" width="60" height="80" as="geometry" /></mxCell><mxCell id="a2" value="Пользователь" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=12;" parent="1" vertex="1"><mxGeometry x="40" y="325" width="60" height="80" as="geometry" /></mxCell><mxCell id="a3" value="Покупатель / гость" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=12;" parent="1" vertex="1"><mxGeometry x="40" y="480" width="60" height="80" as="geometry" /></mxCell><mxCell id="a4" value="Менеджер" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=12;" parent="1" vertex="1"><mxGeometry x="1060" y="330" width="60" height="80" as="geometry" /></mxCell><mxCell id="a5" value="Администратор" style="sha